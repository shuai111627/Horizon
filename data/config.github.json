{
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": [
      "zh"
    ],
    "analysis_concurrency": 3,
    "enrichment_concurrency": 3
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 7.0,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 4.0,
        "topic_dedup": false
      },
      "finance-news": {
        "threshold": 7.0,
        "topic_dedup": true
      },
      "policy-news": {
        "threshold": 7.0,
        "topic_dedup": true
      }
    }
  },
  "sources": {
    "github": [
      {
        "type": "user_events",
        "username": "karpathy",
        "enabled": true,
        "profile": "ai-creator"
      },
      {
        "type": "repo_releases",
        "owner": "vllm-project",
        "repo": "vllm",
        "enabled": true,
        "profile": "ai-creator"
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 150,
      "profile": "ai-creator"
    },
    "rss": [
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tools",
        "profile": "ai-creator"
      },
      {
        "name": "GitHub Trending - Daily",
        "url": "https://mshibanami.github.io/GitHubTrendingRSS/daily/all.xml",
        "enabled": true,
        "category": "github-trending",
        "profile": "ai-creator"
      },
      {
        "name": "CNBC Finance",
        "url": "https://search.cnbc.com/rs/search/combinedcms/view.xml?partnerId=wrss01&id=10000664",
        "enabled": true,
        "category": "finance",
        "profile": "finance-news"
      },
      {
        "name": "Federal Reserve Press Releases",
        "url": "https://www.federalreserve.gov/feeds/press_all.xml",
        "enabled": true,
        "category": "central-bank-policy",
        "profile": ["finance-news", "policy-news"]
      },
      {
        "name": "European Central Bank Press Releases",
        "url": "https://www.ecb.europa.eu/rss/press.html",
        "enabled": true,
        "category": "central-bank-policy",
        "profile": ["finance-news", "policy-news"]
      },
      {
        "name": "AI Regulation News",
        "url": "https://news.google.com/rss/search?q=artificial+intelligence+regulation+policy&hl=en-US&gl=US&ceid=US:en",
        "enabled": true,
        "category": "ai-policy",
        "profile": "policy-news"
      },
      {
        "name": "China Financial Policy",
        "url": "https://news.google.com/rss/search?q=China+financial+regulation+monetary+policy&hl=en-US&gl=US&ceid=US:en",
        "enabled": true,
        "category": "china-policy",
        "profile": ["finance-news", "policy-news"]
      }
    ],
    "reddit": {
      "enabled": false,
      "subreddits": [],
      "users": [],
      "fetch_comments": 10
    },
    "telegram": {
      "enabled": false,
      "channels": []
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 15,
    "profile_order": [
      "tech-news",
      "ai-creator",
      "tech-blog",
      "finance-news",
      "policy-news"
    ],
    "category_groups": {},
    "default_group": "other",
    "default_group_limit": null
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary_and_items",
    "overview_position": "last",
    "platform": "feishu",
    "layout": "collapsible",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": {
      "msg_type": "interactive",
      "card": {
        "schema": "2.0",
        "config": {
          "wide_screen_mode": true
        },
        "header": {
          "title": {
            "tag": "plain_text",
            "content": "#{message_title}"
          },
          "template": "blue"
        },
        "body": {
          "elements": [
            {
              "tag": "markdown",
              "content": "#{summary}"
            }
          ]
        }
      }
    },
    "headers": ""
  }
}
